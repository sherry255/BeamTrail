{application, beamtrail,
 [{description, "PostgreSQL-backed durable step runner for Erlang/OTP"},
  {vsn, "0.2.0-pre.1"},
  {registered, [beamtrail_memory_storage, beamtrail_postgres_pool,
                beamtrail_run_registry, beamtrail_run_sup,
                beamtrail_scanner]},
  {applications, [kernel, stdlib, epgsql]},
  {mod, {beamtrail_app, []}},
  {env, []}]}.
