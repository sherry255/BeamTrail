{erl_opts, [debug_info, warnings_as_errors]}.

{description, "PostgreSQL-backed durable step runner for Erlang/OTP"}.

{licenses, ["MIT"]}.

{links, [
    {"GitHub", "https://github.com/sherry255/BeamTrail"}
]}.

{files, [
    "src",
    "priv",
    "README.md",
    "ARCHITECTURE.md",
    "DECIDER.md",
    "TIMER.md",
    "APPROVAL.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "ROADMAP.md",
    "LICENSE",
    "rebar.config"
]}.

{deps, [
    {epgsql, "4.8.0"}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls,
    deprecated_functions
]}.

{dialyzer, [
    {base_plt_location, "_build/dialyzer"},
    {plt_apps, all_deps}
]}.

{eunit_opts, [verbose]}.
