{erl_opts, [debug_info, warnings_as_errors]}.

{description, "PostgreSQL-backed durable step runner for Erlang/OTP"}.

{licenses, ["MIT"]}.

{links, [
    {"GitHub", "https://github.com/sherry255/BeamTrail"}
]}.

{files, [
    "src",
    "priv",
    "README.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "LICENSE",
    "rebar.config"
]}.

{deps, [
    {epgsql, "4.8.0"}
]}.

{eunit_opts, [verbose]}.
